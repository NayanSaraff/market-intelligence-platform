# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Streamlit secrets / runtime files
.streamlit/secrets.toml
.streamlit/*.log

# Editor / temp files
*.tmp
*.bak
*.orig

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints
