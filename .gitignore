# Data (raw data — too large for git)
data/raw/*.csv
data/processed/*.csv
data/features/*.csv
data/raw/*
data/processed/*
data/features/*
# Keep structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep

# Model weights (large files)
models/**/*.h5
models/**/*.keras
models/**/*.pkl
models/**/*.json
models/**/*.joblib
models/**/*.pt
models/**/*.pth
models/**/*.sav
# Keep structure
!models/**/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Generated outputs
outputs/*
!outputs/.gitkeep
!outputs/charts/
!outputs/charts/**
!outputs/portfolio/
!outputs/portfolio/**
!outputs/predictions/
!outputs/predictions/**
!outputs/reports/
!outputs/reports/**
!outputs/forecasts/
!outputs/forecasts/.gitkeep
!outputs/metrics/
!outputs/metrics/.gitkeep
!outputs/plots/
!outputs/plots/.gitkeep

# Legacy report folder
report/*
!report/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Outputs (keep charts, not large files)
outputs/reports/*.pdf
